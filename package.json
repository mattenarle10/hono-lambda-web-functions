{
  "name": "hono-lambda-web-poc",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "bun --watch src/server.ts",
    "build": "bun scripts/build.ts",
    "start": "node build/app/index.js",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "smoke": "CDK_DEPLOY_ACCOUNT=111122223333 CDK_DEPLOY_REGION=ap-northeast-1 bun run synth && node scripts/smoke.mjs",
    "synth": "cdkd synth HonoLambdaWebDirectStack",
    "diff": "cdkd diff HonoLambdaWebDirectStack --no-cfn-fallback --state-prefix hono-web-poc",
    "deploy": "cdkd deploy HonoLambdaWebDirectStack --no-cfn-fallback --strict-getatt --require-approval any-change --state-prefix hono-web-poc",
    "destroy": "cdkd destroy HonoLambdaWebDirectStack --state-prefix hono-web-poc",
    "bootstrap": "cdkd bootstrap",
    "bench:http": "node scripts/bench-http.mjs"
  },
  "dependencies": {
    "@hono/node-server": "2.0.4",
    "@hono/zod-openapi": "1.4.0",
    "@scalar/hono-api-reference": "0.11.3",
    "hono": "4.12.25"
  },
  "devDependencies": {
    "@go-to-k/cdkd": "0.299.1",
    "@types/bun": "1.3.14",
    "@types/node": "24.19.2",
    "aws-cdk-lib": "2.273.0",
    "constructs": "10.6.0",
    "esbuild": "0.28.1",
    "typescript": "6.0.3"
  }
}
